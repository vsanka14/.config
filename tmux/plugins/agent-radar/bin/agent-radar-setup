#!/usr/bin/env bash

set -euo pipefail
umask 077

SCRIPT_PATH=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH=$(dirname -- "$SCRIPT_PATH")/$LINK_TARGET ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
source "$PLUGIN_ROOT/lib/config.sh"

COPILOT_ROOT=${COPILOT_HOME:-$HOME/.copilot}
HOOK_DIR=${AGENT_RADAR_COPILOT_HOOK_DIR:-$COPILOT_ROOT/hooks}
DESCRIPTOR=${AGENT_RADAR_COPILOT_DESCRIPTOR:-$HOOK_DIR/tmux-agent-status.json}
TEMPLATE=$PLUGIN_ROOT/hooks/copilot.json.in
HOOK_BIN=$PLUGIN_ROOT/bin/agent-radar-hook
TMUX_BIN=${AGENT_RADAR_TMUX_BIN:-tmux}
configured_state_dir=
if [ -z "${AGENT_RADAR_STATE_DIR:-}" ] && command -v "$TMUX_BIN" >/dev/null 2>&1; then
  configured_state_dir=$("$TMUX_BIN" show-option -gqv @agent-radar-state-dir 2>/dev/null) ||
    configured_state_dir=
fi
STATE_DIR=${AGENT_RADAR_STATE_DIR:-${configured_state_dir:-$(agent_radar_state_dir)}}
LEGACY_STATE_DIR=${AGENT_RADAR_LEGACY_STATE_DIR:-$COPILOT_ROOT/agent-status}

die() {
  printf 'agent-radar-setup: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

shell_quote() {
  printf '%q' "$1"
}

descriptor_command() {
  printf 'env AGENT_RADAR_STATE_DIR=%s %s' \
    "$(shell_quote "$STATE_DIR")" "$(shell_quote "$HOOK_BIN")"
}

install_descriptor() {
  require_command jq
  [ -x "$HOOK_BIN" ] || die "$HOOK_BIN is not executable"
  [ -f "$TEMPLATE" ] || die "missing hook template: $TEMPLATE"

  mkdir -p "$HOOK_DIR"
  chmod 700 "$HOOK_DIR" 2>/dev/null || true

  local command temp
  command=$(descriptor_command)
  temp=$(mktemp "$HOOK_DIR/.agent-radar-hook.XXXXXX")
  jq --arg command "$command" '
    .hooks |= with_entries(
      .value |= map(.command |= sub("__COMMAND__"; $command))
    )
  ' "$TEMPLATE" >"$temp"
  chmod 600 "$temp"
  mv -f "$temp" "$DESCRIPTOR"
}

valid_state_file() {
  jq -e '
    (.pane_id | type == "string")
    and (.status == "idle" or .status == "working" or .status == "awaiting")
    and (.updated_epoch | type == "number")
  ' "$1" >/dev/null 2>&1
}

prepare_state_dir() {
  [ ! -L "$STATE_DIR" ] || die "refusing symlinked state directory: $STATE_DIR"
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
}

migrate_legacy_state() {
  [ "$LEGACY_STATE_DIR" != "$STATE_DIR" ] || return 0
  [ -d "$LEGACY_STATE_DIR" ] && [ ! -L "$LEGACY_STATE_DIR" ] || return 0

  local source name destination source_epoch destination_epoch temp
  for source in "$LEGACY_STATE_DIR"/*.json; do
    [ -f "$source" ] && [ ! -L "$source" ] || continue
    valid_state_file "$source" || continue
    name=$(basename "$source")
    destination=$STATE_DIR/$name
    [ ! -L "$destination" ] || continue
    if valid_state_file "$destination"; then
      source_epoch=$(jq -r '.updated_epoch' "$source")
      destination_epoch=$(jq -r '.updated_epoch' "$destination")
      [ "$destination_epoch" -lt "$source_epoch" ] || continue
    fi
    temp=$(mktemp "$STATE_DIR/.migrate.XXXXXX")
    cp "$source" "$temp"
    chmod 600 "$temp"
    mv -f "$temp" "$destination"
  done
}

clean_legacy_state() {
  [ "$LEGACY_STATE_DIR" != "$STATE_DIR" ] || return 0
  [ -d "$LEGACY_STATE_DIR" ] && [ ! -L "$LEGACY_STATE_DIR" ] || return 0
  case "$LEGACY_STATE_DIR" in
    */agent-status) ;;
    *) die "refusing to clean unexpected legacy directory: $LEGACY_STATE_DIR" ;;
  esac

  local file
  for file in \
    "$LEGACY_STATE_DIR"/*.json \
    "$LEGACY_STATE_DIR"/.tmux-status.cache \
    "$LEGACY_STATE_DIR"/.tmux-status.cache.*; do
    [ -f "$file" ] && [ ! -L "$file" ] && rm -f -- "$file"
  done
  rmdir "$LEGACY_STATE_DIR/.tmux-status.cache.lock" 2>/dev/null || true

  if [ -d "$LEGACY_STATE_DIR/.status" ] && [ ! -L "$LEGACY_STATE_DIR/.status" ]; then
    for file in "$LEGACY_STATE_DIR/.status"/*.txt "$LEGACY_STATE_DIR/.status/.stamp"; do
      [ -f "$file" ] && [ ! -L "$file" ] && rm -f -- "$file"
    done
    rmdir "$LEGACY_STATE_DIR/.status/.refresh.lock" 2>/dev/null || true
    rmdir "$LEGACY_STATE_DIR/.status" 2>/dev/null || true
  fi
  rmdir "$LEGACY_STATE_DIR" 2>/dev/null || true
}

file_mode() {
  stat -f %Lp "$1" 2>/dev/null || stat -c %a "$1" 2>/dev/null
}

doctor() {
  local failed=0 command
  for command in tmux jq fzf; do
    if command -v "$command" >/dev/null 2>&1; then
      printf 'ok - %s\n' "$command"
    else
      printf 'not ok - missing %s\n' "$command"
      failed=1
    fi
  done

  command=$(descriptor_command)
  if [ -f "$DESCRIPTOR" ] && jq -e --arg command "$command" '
    .version == 1
    and ([.hooks[][] | .command] | length == 12)
    and ((.hooks | keys) == [
      "agentStop",
      "errorOccurred",
      "notification",
      "permissionRequest",
      "postToolUse",
      "postToolUseFailure",
      "preToolUse",
      "sessionEnd",
      "sessionStart",
      "subagentStart",
      "subagentStop",
      "userPromptSubmitted"
    ])
    and all(.hooks[][]; (.command | startswith($command + " ")))
  ' "$DESCRIPTOR" >/dev/null 2>&1; then
    printf 'ok - Copilot hook descriptor\n'
  else
    printf 'not ok - Copilot hook descriptor\n'
    failed=1
  fi

  if [ ! -e "$STATE_DIR" ]; then
    printf 'ok - state directory not created yet\n'
  elif [ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ] &&
       [ "$(file_mode "$STATE_DIR")" = 700 ]; then
    printf 'ok - state directory permissions\n'
  else
    printf 'not ok - state directory permissions\n'
    failed=1
  fi

  return "$failed"
}

case "${1:-install}" in
  install)
    prepare_state_dir
    migrate_legacy_state
    install_descriptor
    clean_legacy_state
    printf 'installed %s\n' "$DESCRIPTOR"
    ;;
  doctor)
    doctor
    ;;
  *)
    die "usage: agent-radar-setup [install|doctor]"
    ;;
esac
