#!/usr/bin/env bash

# agent-radar: the single source of truth for tmux AI-agent status.
# Despite the interactive Alt+C popup being its most visible mode, this is the
# shared engine behind ALL three surfaces — it does the pane scan + status
# derivation once and every consumer renders from it:
#   (no args)               -> interactive fzf picker popup (Alt+C)
#   --tmux-status-cached    -> tmux status-right pill + cross-session radar dots
#   --notify-lines          -> external notification-consumer feed
#   --refresh [--notify]    -> recompute cached strings; redraw tmux + nudge bar
# Consumers must NOT re-implement the scan; extend a mode here so every surface
# stays in lockstep.
#
# Requires the agent-radar-hook Copilot integration to produce per-pane state.

set -euo pipefail

SCRIPT_PATH=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH=$(dirname -- "$SCRIPT_PATH")/$LINK_TARGET ;;
  esac
done

# Keep tmux's status-right render path genuinely cheap. Hook transitions
# precompute the output, so avoid loading adapters or querying tmux when serving
# an existing per-session cache.
if [ "${1:-}" = --tmux-status-cached ] && [ $# -eq 2 ]; then
  if [ -n "${AGENT_RADAR_STATE_DIR:-}" ]; then
    fast_state_dir=$AGENT_RADAR_STATE_DIR
  elif [ -n "${TMUX_AGENT_ENGINE_STATE_DIR:-}" ]; then
    fast_state_dir=$TMUX_AGENT_ENGINE_STATE_DIR
  else
    fast_state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/agent-radar
  fi
  fast_status_dir=${TMUX_AGENT_ENGINE_STATUS_DIR:-$fast_state_dir/.status}
  fast_key=$(printf '%s' "$2" | od -An -v -tx1 2>/dev/null | tr -d ' \n')
  fast_file=$fast_status_dir/$fast_key.txt
  if [ -f "$fast_file" ]; then
    cat "$fast_file"
    exit 0
  fi
fi

case "$SCRIPT_PATH" in
  */*) SCRIPT_DIR=$(CDPATH= cd -- "${SCRIPT_PATH%/*}" && pwd) ;;
  *)
    SCRIPT_PATH=$(command -v "$SCRIPT_PATH")
    SCRIPT_DIR=${SCRIPT_PATH%/*}
    ;;
esac
PLUGIN_ROOT=${SCRIPT_DIR%/*}
source "$PLUGIN_ROOT/lib/config.sh"
AGENT_RADAR_ENGINE_BIN=$SCRIPT_DIR/agent-radar
source "$PLUGIN_ROOT/lib/notify.sh"
source "$PLUGIN_ROOT/agents/copilot.sh"
source "$PLUGIN_ROOT/lib/render.sh"
source "$PLUGIN_ROOT/lib/detection.sh"

TMUX_BIN=${AGENT_RADAR_TMUX_BIN:-${TMUX_AGENT_ENGINE_TMUX_BIN:-tmux}}
STATE_DIR=${AGENT_RADAR_STATE_DIR:-${TMUX_AGENT_ENGINE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-radar}}
# Deterministic runs (tests) pin NOW; treat that as a signal to bypass the
# time-based render cache so fixtures stay hermetic.
if [ -n "${TMUX_AGENT_ENGINE_NOW:-}" ]; then NOW_OVERRIDDEN=1; else NOW_OVERRIDDEN=0; fi
NOW=${TMUX_AGENT_ENGINE_NOW:-$(date '+%s')}
# Shared render cache: the status-right #() is expanded once per attached
# client every status-interval, and each expansion recomputes identical global
# agent state. Cache the heavy per-pane scan briefly so N clients cost one scan
# per window instead of N. Set TTL to 0 to disable.
CACHE_TTL=${AGENT_RADAR_CACHE_TTL:-${TMUX_AGENT_ENGINE_CACHE_TTL:-2}}
CACHE_FILE=${TMUX_AGENT_ENGINE_CACHE_FILE:-$STATE_DIR/.tmux-status.cache}
CACHE_LOCK_STALE=${TMUX_AGENT_ENGINE_CACHE_LOCK_STALE:-30}
# Precomputed per-session status-right strings. Hook transitions refresh these
# files so the render path only cats the current session's string.
STATUS_DIR=${TMUX_AGENT_ENGINE_STATUS_DIR:-$STATE_DIR/.status}
STATUS_LOCK=$STATUS_DIR/.refresh.lock
STATUS_PENDING=$STATUS_DIR/.pending
STATUS_NOTIFY_PENDING=$STATUS_DIR/.notify-pending
STATUS_LOCK_STALE=${TMUX_AGENT_ENGINE_STATUS_LOCK_STALE:-30}
COLOR_AWAITING=${AGENT_RADAR_COLOR_AWAITING:-#f7768e}
COLOR_WORKING=${AGENT_RADAR_COLOR_WORKING:-#e0af68}
COLOR_DONE=${AGENT_RADAR_COLOR_DONE:-#3fb950}
COLOR_IDLE=${AGENT_RADAR_COLOR_IDLE:-#9ece6a}
COLOR_ACCENT=${AGENT_RADAR_COLOR_ACCENT:-#7dcfff}
COLOR_MUTED=${AGENT_RADAR_COLOR_MUTED:-#565f89}
COLOR_DIM=${AGENT_RADAR_COLOR_DIM:-#414868}
COLOR_PILL_BG=${AGENT_RADAR_COLOR_PILL_BG:-#24283b}
COLOR_STATUS_BG=${AGENT_RADAR_COLOR_STATUS_BG:-#050505}

die() {
  printf 'agent-radar: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}


# Serve the lean status rows from a short-lived shared cache so concurrent
# status-right expansions (one per attached client, every status-interval)
# collapse to a single heavy scan per cache window. A single refresher holds a
# lock and writes atomically; everyone else serves the (possibly stale) cache,
# falling back to a direct scan only when there's nothing cached yet.
cached_lean_rows() {
  if [ "${NOW_OVERRIDDEN:-0}" = 1 ] || [ "${CACHE_TTL:-0}" -le 0 ]; then
    list_rows lean
    return
  fi

  local mtime age lock=$CACHE_FILE.lock
  if [ -f "$CACHE_FILE" ]; then
    mtime=$(agent_radar_file_mtime "$CACHE_FILE" || printf '0')
    age=$((NOW - mtime))
    if [ "$age" -ge 0 ] && [ "$age" -le "$CACHE_TTL" ]; then
      cat "$CACHE_FILE"
      return
    fi
  fi

  mkdir -p "$STATE_DIR" 2>/dev/null || { list_rows lean; return; }
  chmod 700 "$STATE_DIR" 2>/dev/null || true

  # Reap an abandoned lock so a crashed refresher can't freeze the cache.
  if [ -d "$lock" ]; then
    mtime=$(agent_radar_file_mtime "$lock" || printf '0')
    [ $((NOW - mtime)) -le "$CACHE_LOCK_STALE" ] || rmdir "$lock" 2>/dev/null || true
  fi

  if mkdir "$lock" 2>/dev/null; then
    local tmp
    if tmp=$(mktemp "$CACHE_FILE.XXXXXX" 2>/dev/null); then
      if list_rows lean >"$tmp" 2>/dev/null; then
        chmod 600 "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$CACHE_FILE" 2>/dev/null || rm -f "$tmp"
      else
        rm -f "$tmp"
      fi
    fi
    rmdir "$lock" 2>/dev/null || true
  fi

  if [ -f "$CACHE_FILE" ]; then
    cat "$CACHE_FILE"
  else
    list_rows lean
  fi
}

# Renders the status-right: current-session pill (glyph coloured by the global
# most-urgent status) followed by a cross-session radar (one dot per session,
# coloured by that session's most-urgent agent).
tmux_status() {
  local session=$1
  local session_order session_count
  session_order=$(
    "$TMUX_BIN" list-sessions -F '#{session_created}	#{session_name}' 2>/dev/null |
      sort -n |
      cut -f2-
  )
  session_count=$(printf '%s' "$session_order" | grep -c .)

  local rows rows_source
  if [ -n "${LEAN_ROWS_OVERRIDE_FILE:-}" ]; then
    rows_source=$(cat "$LEAN_ROWS_OVERRIDE_FILE")
  else
    rows_source=$(cached_lean_rows)
  fi
  rows=$(
    printf '%s\n' "$rows_source" |
      awk -F '\t' '
        BEGIN { OFS = "\t" }
        {
          position = $4
          sub(/^.*:/, "", position)
          split(position, parts, ".")
          print parts[1] + 0, parts[2] + 0, $0
        }
      ' |
      sort -t $'\t' -k1,1n -k2,2n |
      cut -f3-
  )

  # Most-urgent priority per session (0=awaiting, 1=done flash, 2=other agent),
  # computed in awk to stay bash 3.2 safe. done outranks working here so a
  # completion still flashes green even alongside a working pane.
  local prioritymap
  prioritymap=$(printf '%s\n' "$rows" | awk -F '\t' '
    $1 ~ /^[0-9]+$/ {
      p = ($1 == 1) ? 0 : ($1 == 3) ? 1 : 2
      if (!($3 in best) || p < best[$3]) best[$3] = p
    }
    END { for (s in best) print s "\t" best[s] }
  ')

  local global_priority
  global_priority=$(printf '%s\n' "$prioritymap" | awk -F '\t' 'BEGIN { m = 9 } $2 != "" { if ($2 < m) m = $2 } END { print m }')
  [ -n "$global_priority" ] || global_priority=9

  # Pill cells for the current session, in pane order.
  local pill= rank pane_id row_session target pane_target
  while IFS=$'\t' read -r rank pane_id row_session target; do
    [ -n "${rank:-}" ] || continue
    case "$rank" in *[!0-9]*) continue ;; esac
    [ "$row_session" = "$session" ] || continue
    pane_target=${target#*:}
    pill="$pill$(pill_cell "$rank" "$pane_target")"
  done <<<"$rows"

  # Pill \u2014 only when the current session actually has agent panes.
  local pill_block=
  if [ -n "$pill" ]; then
    local glyph_fg
    case "$global_priority" in
      0) glyph_fg=$COLOR_AWAITING ;;
      1) glyph_fg=$COLOR_DONE ;;
      *) glyph_fg=$COLOR_ACCENT ;;
    esac
    pill_block="#[fg=${glyph_fg},bg=${COLOR_PILL_BG},bold]   ${pill}#[bg=${COLOR_STATUS_BG},nobold]"
  fi

  # Radar \u2014 one dot per session (creation order); only when >1 session exists.
  local radar=
  if [ "${session_count:-0}" -gt 1 ]; then
    local name glyph color dots= current_flag best
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if [ "$name" = "$session" ]; then
        glyph="◉"
        current_flag=1
      else
        glyph="●"
        current_flag=0
      fi
      best=$(printf '%s\n' "$prioritymap" | awk -F '\t' -v s="$name" '$1 == s { print $2; exit }')
      color=$(dot_color "$best" "$current_flag")
      dots="$dots#[fg=${color}]${glyph} "
    done <<<"$session_order"
    radar="$dots"
  fi

  [ -n "$pill_block" ] || [ -n "$radar" ] || return

  local out=
  [ -n "$pill_block" ] && out="$pill_block"
  if [ -n "$radar" ]; then
    [ -n "$out" ] && out="$out "
    out="$out$radar"
  fi
  printf '%s#[default]' "$out"
}

# Notification feed. Reuses the shared lean scan + the same per-session priority
# folding as the status-right pill (awaiting=0 > done-flash=1 > other=2) so the
# menu-bar icon and popup stay in lockstep with tmux. Emits:
#   COLOR<TAB><hex>            global most-urgent icon colour (only when >=1 agent
#                              is tracked; absent output => hide the bar icon)
#   LINE<TAB><session><TAB><kind>  one per session whose most-urgent state is
#                              notable (kind = awaiting|done), in session-creation
#                              order to match the radar.
notify_lines() {
  require_command "$TMUX_BIN"
  require_command jq
  local session_order rows
  session_order=$("$TMUX_BIN" list-sessions -F '#{session_created}	#{session_name}' 2>/dev/null |
    sort -n | cut -f2-) || session_order=
  rows=$(cached_lean_rows) || rows=
  printf '%s\n' "$rows" | ORDERLIST="$session_order" awk -F '\t' '
    BEGIN {
      n = split(ENVIRON["ORDERLIST"], arr, "\n")
      for (i = 1; i <= n; i++) { if (arr[i] != "") pos[arr[i]] = i }
    }
    $1 ~ /^[0-9]+$/ {
      s = $3
      p = ($1 == 1) ? 0 : ($1 == 3) ? 1 : 2
      if (!(s in best) || p < best[s]) best[s] = p
      any = 1
    }
    END {
      if (!any) exit 0
      gp = 9
      for (s in best) if (best[s] < gp) gp = best[s]
      color = (gp == 0) ? "#f7768e" : (gp == 1) ? "#3fb950" : "#7dcfff"
      print "COLOR\t" color
      for (i = 1; i <= n; i++) {
        s = arr[i]
        if (s == "" || !(s in best) || best[s] > 1) continue
        kind = (best[s] == 0) ? "awaiting" : "done"
        print "LINE\t" s "\t" kind
        emitted[s] = 1
      }
      # Notable sessions absent from the creation-order list (rare) still count.
      for (s in best) {
        if (best[s] > 1 || (s in emitted)) continue
        kind = (best[s] == 0) ? "awaiting" : "done"
        print "LINE\t" s "\t" kind
      }
    }
  '
}

# Filename-safe, collision-free key for a session name (hex of its raw bytes).
session_key() {
  printf '%s' "$1" | od -An -v -tx1 2>/dev/null | tr -d ' \n'
}

# Precompute every session's status-right string into STATUS_DIR so the render
# path becomes a bare cat. One heavy scan (served through the shared lean cache)
# feeds every per-session render. Serialized by a lock that self-heals once it
# ages past STATUS_LOCK_STALE. Pass 1 to redraw clients when done.
refresh_all() {
  local notify=${1:-0}
  require_command "$TMUX_BIN"
  require_command jq
  mkdir -p "$STATUS_DIR" 2>/dev/null || return 1
  chmod 700 "$STATUS_DIR" 2>/dev/null || true
  : >"$STATUS_PENDING"
  [ "$notify" = 1 ] && : >"$STATUS_NOTIFY_PENDING"

  if [ -d "$STATUS_LOCK" ]; then
    local lmtime
    lmtime=$(agent_radar_file_mtime "$STATUS_LOCK" || printf '0')
    [ $((NOW - lmtime)) -le "$STATUS_LOCK_STALE" ] || rmdir "$STATUS_LOCK" 2>/dev/null || true
  fi
  # A busy lock leaves the pending marker for its owner to consume.
  mkdir "$STATUS_LOCK" 2>/dev/null || return 0

  local sessions keep name key out tmp f base fresh_rows_file cache_tmp
  while [ -f "$STATUS_PENDING" ]; do
    rm -f "$STATUS_PENDING"
    fresh_rows_file=$(mktemp "$STATUS_DIR/.rows.XXXXXX")
    ( list_rows lean ) >"$fresh_rows_file"
    LEAN_ROWS_OVERRIDE_FILE=$fresh_rows_file

    mkdir -p "$STATE_DIR" 2>/dev/null || true
    if cache_tmp=$(mktemp "$CACHE_FILE.XXXXXX" 2>/dev/null); then
      cp "$fresh_rows_file" "$cache_tmp"
      chmod 600 "$cache_tmp" 2>/dev/null || true
      mv -f "$cache_tmp" "$CACHE_FILE" 2>/dev/null || rm -f "$cache_tmp"
    fi

    keep=" "
    sessions=$("$TMUX_BIN" list-sessions -F '#{session_name}' 2>/dev/null) || sessions=
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      key=$(session_key "$name")
      keep="$keep$key "
      out=$(tmux_status "$name" || true)
      if tmp=$(mktemp "$STATUS_DIR/.status.XXXXXX" 2>/dev/null); then
        printf '%s' "$out" >"$tmp"
        chmod 600 "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$STATUS_DIR/$key.txt" 2>/dev/null || rm -f "$tmp"
      fi
    done <<<"$sessions"

    for f in "$STATUS_DIR"/*.txt; do
      [ -e "$f" ] || break
      base=$(basename "$f" .txt)
      case "$keep" in
        *" $base "*) : ;;
        *) rm -f "$f" ;;
      esac
    done
    rm -f "$fresh_rows_file"
    LEAN_ROWS_OVERRIDE_FILE=
  done
  rmdir "$STATUS_LOCK" 2>/dev/null || true
  if [ -f "$STATUS_PENDING" ]; then
    refresh_all "$notify"
    return
  fi
  if [ -f "$STATUS_NOTIFY_PENDING" ]; then
    notify=1
    rm -f "$STATUS_NOTIFY_PENDING"
  fi

  if [ "$notify" = 1 ]; then
    "$TMUX_BIN" refresh-client -S >/dev/null 2>&1 || true
    emit_agent_radar_change
  fi
}

# status-right render path: cat the precomputed string (~1ms) so a session
# switch never waits on the agent scan. Falls back to a synchronous compute only
# when no precomputed string exists yet (first paint), which is no worse than the
# previous always-synchronous behavior.
tmux_status_cached() {
  local session=$1 file
  file=$STATUS_DIR/$(session_key "$session").txt
  if [ -f "$file" ]; then
    cat "$file"
  else
    tmux_status "$session"
  fi
}

switch_to_pane() {
  local pane_id=$1 session=$2
  "$TMUX_BIN" switch-client -t "$session"
  "$TMUX_BIN" select-pane -t "$pane_id"
  "$TMUX_BIN" refresh-client -S >/dev/null 2>&1 || true
}

register_popup_when_ready() {
  local socket=$1 registration=$2 owner_pid=$3 attempts=0
  while [ ! -S "$socket" ] && [ "$attempts" -lt 40 ]; do
    sleep 0.05
    attempts=$((attempts + 1))
  done
  [ -S "$socket" ] || return 0
  printf '%s\n%s\n' "$socket" "$owner_pid" >"$registration"
  chmod 600 "$registration" 2>/dev/null || true
}

case "${1:-}" in
  preview)
    [ $# -eq 2 ] || die "preview requires a pane ID"
    exec "$TMUX_BIN" capture-pane -p -e -t "$2" -S -20
    ;;
  --list)
    list_rows
    exit 0
    ;;
  --tmux-status)
    [ $# -eq 2 ] || die "--tmux-status requires a session name"
    require_command "$TMUX_BIN"
    require_command jq
    tmux_status "$2"
    exit 0
    ;;
  --tmux-status-cached)
    [ $# -eq 2 ] || die "--tmux-status-cached requires a session name"
    tmux_status_cached "$2"
    exit 0
    ;;
  --notify-lines)
    notify_lines
    exit 0
    ;;
  --refresh)
    notify=0
    if [ "${2:-}" = --notify ]; then notify=1; fi
    refresh_all "$notify"
    exit 0
    ;;
esac

require_command "$TMUX_BIN"
require_command fzf
require_command jq
require_command curl

popup_base=${TMPDIR:-/tmp}
[ "${#popup_base}" -le 70 ] || popup_base=/tmp
popup_dir=$(mktemp -d "$popup_base/.agent-radar.XXXXXX")
popup_socket=$popup_dir/fzf.sock
popup_registry=$STATE_DIR/.popups
if [ ! -L "$STATE_DIR" ]; then
  mkdir -p "$popup_registry"
  chmod 700 "$STATE_DIR" "$popup_registry" 2>/dev/null || true
fi
popup_registration=$popup_registry/$$
popup_register_pid=
cleanup_popup() {
  if [ -n "$popup_register_pid" ]; then
    kill "$popup_register_pid" >/dev/null 2>&1 || true
    wait "$popup_register_pid" 2>/dev/null || true
  fi
  rm -f "$popup_registration" "$popup_socket"
  rmdir "$popup_dir" 2>/dev/null || true
}
trap cleanup_popup EXIT
trap 'exit 0' HUP INT TERM
register_popup_when_ready "$popup_socket" "$popup_registration" "$$" &
popup_register_pid=$!
selection=$(
  list_rows |
    fzf --ansi \
      --listen-unsafe="$popup_socket" \
      --track \
      --reverse \
      --border=rounded \
      --border-label='  Agents ' \
      --border-label-pos=3 \
      --prompt='  ' \
      --pointer='▶' \
      --padding=1 \
      --color='bg:-1,fg+:#c0caf5,bg+:#292e42,hl:#7aa2f7,hl+:#7dcfff,gutter:#3b4261,border:#27a1b9,label:#7dcfff,prompt:#7dcfff,pointer:#bb9af7,marker:#9ece6a,header:#565f89,info:#565f89,spinner:#7dcfff' \
      --delimiter=$'\t' \
      --with-nth=7 \
      --header='STATUS      TARGET                      TITLE' \
      --preview="$0 preview {2}" \
      --preview-window='right,55%,border-left,follow'
) || selection=
cleanup_popup
trap - EXIT HUP INT TERM
[ -n "$selection" ] || exit 0

pane_id=$(printf '%s\n' "$selection" | cut -f2)
session=$(printf '%s\n' "$selection" | cut -f3)
[ -n "$pane_id" ] && [ -n "$session" ] || die "invalid selection"
switch_to_pane "$pane_id" "$session"
