#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
RUST_BIN=${AGENT_RADAR_RUST_BIN:-$SCRIPT_DIR/agent-radar-rust}
[ -x "$RUST_BIN" ] || {
  printf 'agent-radar: missing Rust binary; run cargo build --release and install it as %s\n' "$RUST_BIN" >&2
  exit 1
}
exec "$RUST_BIN" "$@"
