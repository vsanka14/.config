#!/usr/bin/env bash

# Copilot adapter hook: maintain privacy-safe status for the current tmux pane.

set -u
umask 077
trap 'exit 0' ERR HUP INT TERM

command -v jq >/dev/null 2>&1 || exit 0

SCRIPT_PATH=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH=$(dirname -- "$SCRIPT_PATH")/$LINK_TARGET ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
source "$PLUGIN_ROOT/lib/config.sh"
AGENT_RADAR_ENGINE_BIN=${AGENT_RADAR_ENGINE_BIN:-$SCRIPT_DIR/agent-radar}
source "$PLUGIN_ROOT/lib/notify.sh"
source "$PLUGIN_ROOT/agents/copilot.sh"

TMUX_BIN=${AGENT_RADAR_TMUX_BIN:-${TMUX_AGENT_STATUS_TMUX_BIN:-tmux}}
DONE_FLASH_TTL=${AGENT_RADAR_DONE_TTL:-${TMUX_AGENT_STATUS_DONE_TTL:-$(agent_radar_tmux_option @agent-radar-done-ttl 3)}}
LOADER_BIN=$PLUGIN_ROOT/agent-radar.tmux

refresh_enabled() {
  [ "${TMUX_AGENT_STATUS_REFRESH:-1}" != 0 ] || return 1
  command -v "$TMUX_BIN" >/dev/null 2>&1
}

refresh_command() {
  local command
  command=$("$TMUX_BIN" show-option -gqv @agent-radar-runtime-command 2>/dev/null) || command=
  case "$command" in
    env\ *agent-radar*) printf '%s --refresh --notify' "$command" ;;
    *) printf "'%s' --refresh" "$LOADER_BIN" ;;
  esac
}

emit_external_notify() {
  [ "${TMUX_AGENT_STATUS_REFRESH:-1}" != 0 ] || return 0
  emit_agent_radar_change
}

# Drop the engine's shared render cache so the very next status-right expansion
# rebuilds with this transition instead of serving stale state for the cache
# TTL. Keeps idle redraws coalesced while making real transitions instant.
invalidate_status_cache() {
  local dir
  dir=$(agent_radar_state_dir)
  rm -f "$dir/.tmux-status.cache" 2>/dev/null || true
}

# Redraw so a transition shows without waiting for the next status-interval tick.
# The engine's status-right render only cats a precomputed string, so regenerate
# those strings off the render path first (--refresh recomputes and then redraws).
# Falls back to a plain redraw when the engine isn't present.
emit_refresh() {
  local command
  refresh_enabled || return 0
  invalidate_status_cache
  command=$(refresh_command)
  if [ -n "$command" ] && "$TMUX_BIN" run-shell -b "$command" >/dev/null 2>&1; then
    return 0
  fi
  "$TMUX_BIN" refresh-client -S >/dev/null 2>&1 || true
}

# One-shot delayed redraw so external notification consumers clear the
# transient "done" flash at expiry. Tmux surfaces retain completion until the
# next lifecycle event updates the pane state.
schedule_refresh() {
  local command
  refresh_enabled || return 0
  [ "${TMUX_AGENT_STATUS_SCHEDULE_REFRESH:-1}" != 0 ] || return 0
  ( sleep "$DONE_FLASH_TTL"; invalidate_status_cache
    command=$(refresh_command)
    if [ -n "$command" ] && "$TMUX_BIN" run-shell -b "$command" >/dev/null 2>&1; then
      :
    else
      "$TMUX_BIN" refresh-client -S >/dev/null 2>&1
    fi
    emit_agent_radar_change
  ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

valid_pane_id() {
  case "$1" in
    %|%*[!0-9]*|[!%]*|'') return 1 ;;
    *) return 0 ;;
  esac
}

resolve_pane_id() {
  if valid_pane_id "${TMUX_PANE:-}"; then
    printf '%s\n' "$TMUX_PANE"
    return 0
  fi

  local tmux_bin=${TMUX_AGENT_STATUS_TMUX_BIN:-tmux}
  command -v "$tmux_bin" >/dev/null 2>&1 || return 1

  local process_file cleanup_process_file=0
  if [ -n "${TMUX_AGENT_STATUS_PS_FILE:-}" ]; then
    process_file=$TMUX_AGENT_STATUS_PS_FILE
  else
    process_file=$(mktemp "${TMPDIR:-/tmp}/agent-radar-hook-ps.XXXXXX") || return 1
    cleanup_process_file=1
    ps -axo pid=,ppid=,comm= >"$process_file" 2>/dev/null || {
      rm -f "$process_file"
      return 1
    }
  fi

  local start_pid=${TMUX_AGENT_STATUS_PROCESS_PID:-$$}
  local copilot_pid
  copilot_pid=$(awk -v start="$start_pid" '
    {
      parent[$1] = $2
      command[$1] = $3
    }
    END {
      current = start
      for (depth = 0; current != "" && current != "0" && depth < 256; depth++) {
        count = split(command[current], parts, "/")
        if (parts[count] == agent_process) {
          print current
          exit
        }
        current = parent[current]
      }
    }
  ' agent_process="$AGENT_RADAR_PROCESS_BASENAME" "$process_file")

  if [ -z "$copilot_pid" ]; then
    [ "$cleanup_process_file" -eq 0 ] || rm -f "$process_file"
    return 1
  fi

  local candidate candidate_pid resolved=
  while IFS=$'\t' read -r candidate candidate_pid; do
    valid_pane_id "$candidate" || continue
    case "$candidate_pid" in
      *[!0-9]*|'') continue ;;
    esac
    if awk -v process="$copilot_pid" -v root="$candidate_pid" '
      { parent[$1] = $2 }
      END {
        current = process
        for (depth = 0; current != "" && current != "0" && depth < 256; depth++) {
          if (current == root) {
            exit 0
          }
          current = parent[current]
        }
        exit 1
      }
    ' "$process_file"; then
      resolved=$candidate
      break
    fi
  done < <("$tmux_bin" list-panes -a -F '#{pane_id}	#{pane_pid}' 2>/dev/null)

  [ "$cleanup_process_file" -eq 0 ] || rm -f "$process_file"
  [ -n "$resolved" ] || return 1
  printf '%s\n' "$resolved"
}

pane_id=$(resolve_pane_id) || exit 0

event=${1:-}
input={}
if [ ! -t 0 ]; then
  input=$(cat 2>/dev/null) || exit 0
  [ -n "$input" ] || input={}
fi
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$input" || exit 0
if [ -z "$event" ]; then
  event=$(jq -r '.hookEventName // .hookName // .eventName // .event // empty' <<<"$input" 2>/dev/null)
fi

tool_name=$(jq -r '
  .toolName // .tool_name //
  (
    [.toolCalls[]? | .name // .toolName // .tool_name // empty]
    | if index("ask_user") then "ask_user" else (.[0] // empty) end
  )
' <<<"$input" 2>/dev/null)
tool_name=$(printf '%.120s' "$tool_name")

event_detail=
case "$event" in
  preToolUse)
    event_detail=$tool_name
    ;;
  notification)
    event_detail=$(jq -r '.notification_type // empty' <<<"$input" 2>/dev/null)
    ;;
  errorOccurred)
    event_detail=$(jq -r 'if .recoverable == true then "true" else "false" end' <<<"$input" 2>/dev/null)
    ;;
esac
status=$(agent_event_status "$event" "$event_detail") || exit 0

state_dir=$(agent_radar_state_dir)
[ -n "$state_dir" ] || exit 0
state_file=$state_dir/${pane_id#%}.json
process_pid=${PPID:-0}
case "$process_pid" in
  *[!0-9]*|'') process_pid=0 ;;
esac

prev_status=
if [ -f "$state_file" ] && [ ! -L "$state_file" ]; then
  prev_status=$(jq -r '.status // empty' "$state_file" 2>/dev/null) || prev_status=
fi

if [ "$status" = removed ]; then
  rm -f -- "$state_file" "$state_dir/.ack/${pane_id#%}" 2>/dev/null
  emit_refresh
  emit_external_notify
  exit 0
fi

if [ "$event" = sessionStart ] && [ -f "$state_file" ] && [ ! -L "$state_file" ]; then
  if jq -e --argjson pid "$process_pid" '
    .process_pid == $pid and (.status == "working" or .status == "awaiting")
  ' "$state_file" >/dev/null 2>&1; then
    exit 0
  fi
fi

[ ! -L "$state_dir" ] || exit 0
mkdir -p -- "$state_dir" 2>/dev/null || exit 0
chmod 700 "$state_dir" 2>/dev/null || exit 0

session_id=$(jq -r '.sessionId // .session_id // "unknown"' <<<"$input" 2>/dev/null)
session_id=$(printf '%s' "$session_id" | tr -cd '[:alnum:]_-')
[ -n "$session_id" ] || session_id=unknown

subagent_name=$(jq -r '.agentDisplayName // .agentName // .agent_name // empty' <<<"$input" 2>/dev/null)
subagent_name=$(printf '%.120s' "$subagent_name")
updated_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || exit 0
updated_epoch=$(date '+%s' 2>/dev/null) || exit 0

# Edge-triggered transient signal: only a real completion (agentStop after the
# agent was working) flashes "done". Fresh sessionStart idle and subagentStop
# must not flash.
flash_kind=
flash_until=0
if [ "$event" = agentStop ] && [ "$prev_status" = working ]; then
  flash_kind=done
  flash_until=$((updated_epoch + DONE_FLASH_TTL))
fi

temp_file=$(mktemp "$state_dir/.agent-radar-hook.XXXXXX" 2>/dev/null) || exit 0
trap 'rm -f -- "$temp_file" 2>/dev/null; exit 0' ERR HUP INT TERM
flash_id=
[ "$flash_kind" != done ] || flash_id=${temp_file##*/}

jq -n \
  --arg pane_id "$pane_id" \
  --arg session_id "$session_id" \
  --arg status "$status" \
  --arg event "$event" \
  --arg tool_name "$tool_name" \
  --arg subagent_name "$subagent_name" \
  --arg updated_at "$updated_at" \
  --arg flash_kind "$flash_kind" \
  --arg flash_id "$flash_id" \
  --argjson process_pid "$process_pid" \
  --argjson updated_epoch "$updated_epoch" \
  --argjson flash_until "$flash_until" '
  {
    pane_id: $pane_id,
    session_id: $session_id,
    process_pid: $process_pid,
    status: $status,
    event: $event,
    updated_at: $updated_at,
    updated_epoch: $updated_epoch
  }
  + (if $tool_name == "" then {} else {tool_name: $tool_name} end)
  + (if $subagent_name == "" then {} else {subagent_name: $subagent_name} end)
  + (
      if $flash_kind == "" then {}
      else {
        flash: {
          kind: $flash_kind,
          until_epoch: $flash_until,
          id: $flash_id
        }
      }
    end)
' >"$temp_file" 2>/dev/null || exit 0

chmod 600 "$temp_file" 2>/dev/null || exit 0
mv -f -- "$temp_file" "$state_file" 2>/dev/null || exit 0
[ "$flash_kind" = done ] || rm -f -- "$state_dir/.ack/${pane_id#%}" 2>/dev/null

if [ "$prev_status" != "$status" ] || [ -n "$flash_kind" ]; then
  emit_refresh
  emit_external_notify
fi
[ "$flash_kind" = done ] && schedule_refresh
exit 0
