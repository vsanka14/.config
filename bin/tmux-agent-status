#!/usr/bin/env bash

# Copilot hook: maintain privacy-safe status for the current tmux pane.
# Required registration lives only at ~/.copilot/hooks/tmux-agent-status.json.

set -u
umask 077
trap 'exit 0' ERR HUP INT TERM

command -v jq >/dev/null 2>&1 || exit 0

TMUX_BIN=${TMUX_AGENT_STATUS_TMUX_BIN:-tmux}
DONE_FLASH_TTL=${TMUX_AGENT_STATUS_DONE_TTL:-3}
PICKER_BIN=${TMUX_AGENT_STATUS_PICKER_BIN:-${HOME:-}/.config/bin/tmux-agent-picker}

refresh_enabled() {
  [ "${TMUX_AGENT_STATUS_REFRESH:-1}" != 0 ] || return 1
  command -v "$TMUX_BIN" >/dev/null 2>&1
}

# SketchyBar notifications ride the same enable switch as the tmux redraw so
# tests (which pin TMUX_AGENT_STATUS_REFRESH=0) stay hermetic. Guarded by the
# binary so machines without SketchyBar are unaffected.
sketchybar_enabled() {
  [ "${TMUX_AGENT_STATUS_SKETCHYBAR:-1}" != 0 ] || return 1
  [ "${TMUX_AGENT_STATUS_REFRESH:-1}" != 0 ] || return 1
  command -v sketchybar >/dev/null 2>&1
}

# Push a transient agent notification to the menu bar on a real transition. The
# SketchyBar plugin re-derives the full notable set (and whether it is a blocking
# awaiting or a transient done) via tmux-agent-picker, so no per-pane payload is
# needed here. Fire-and-forget; never blocks the hook.
emit_sketchybar_notify() {
  sketchybar_enabled || return 0
  ( sketchybar --trigger agent_notify >/dev/null 2>&1 ) &
  disown 2>/dev/null || true
}

# Drop the picker's shared render cache so the very next status-right expansion
# rebuilds with this transition instead of serving stale state for the cache
# TTL. Keeps idle redraws coalesced while making real transitions instant.
invalidate_status_cache() {
  local dir=${COPILOT_HOME:-${HOME:-}/.copilot}/agent-status
  rm -f "$dir/.tmux-status.cache" 2>/dev/null || true
}

# Redraw so a transition shows without waiting for the next status-interval tick.
# The picker's status-right render only cats a precomputed string, so regenerate
# those strings off the render path first (--refresh recomputes and then redraws).
# Falls back to a plain redraw when the picker isn't present.
emit_refresh() {
  refresh_enabled || return 0
  invalidate_status_cache
  if [ -x "$PICKER_BIN" ] && "$TMUX_BIN" run-shell -b "'$PICKER_BIN' --refresh --notify" >/dev/null 2>&1; then
    return 0
  fi
  "$TMUX_BIN" refresh-client -S >/dev/null 2>&1 || true
}

# One-shot delayed redraw so a transient "done" flash decays crisply at expiry
# instead of lingering until the next poll.
schedule_refresh() {
  refresh_enabled || return 0
  [ "${TMUX_AGENT_STATUS_SCHEDULE_REFRESH:-1}" != 0 ] || return 0
  ( sleep "$DONE_FLASH_TTL"; invalidate_status_cache
    if [ -x "$PICKER_BIN" ] && "$TMUX_BIN" run-shell -b "'$PICKER_BIN' --refresh --notify" >/dev/null 2>&1; then
      :
    else
      "$TMUX_BIN" refresh-client -S >/dev/null 2>&1
    fi
    command -v sketchybar >/dev/null 2>&1 &&
      sketchybar --trigger agent_notify >/dev/null 2>&1
  ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

valid_pane_id() {
  case "$1" in
    %|%*[!0-9]*|[!%]*|'') return 1 ;;
    *) return 0 ;;
  esac
}

resolve_pane_id() {
  if valid_pane_id "${TMUX_PANE:-}"; then
    printf '%s\n' "$TMUX_PANE"
    return 0
  fi

  local tmux_bin=${TMUX_AGENT_STATUS_TMUX_BIN:-tmux}
  command -v "$tmux_bin" >/dev/null 2>&1 || return 1

  local process_file cleanup_process_file=0
  if [ -n "${TMUX_AGENT_STATUS_PS_FILE:-}" ]; then
    process_file=$TMUX_AGENT_STATUS_PS_FILE
  else
    process_file=$(mktemp "${TMPDIR:-/tmp}/tmux-agent-status-ps.XXXXXX") || return 1
    cleanup_process_file=1
    ps -axo pid=,ppid=,comm= >"$process_file" 2>/dev/null || {
      rm -f "$process_file"
      return 1
    }
  fi

  local start_pid=${TMUX_AGENT_STATUS_PROCESS_PID:-$$}
  local copilot_pid
  copilot_pid=$(awk -v start="$start_pid" '
    {
      parent[$1] = $2
      command[$1] = $3
    }
    END {
      current = start
      for (depth = 0; current != "" && current != "0" && depth < 256; depth++) {
        count = split(command[current], parts, "/")
        if (parts[count] == "copilot") {
          print current
          exit
        }
        current = parent[current]
      }
    }
  ' "$process_file")

  if [ -z "$copilot_pid" ]; then
    [ "$cleanup_process_file" -eq 0 ] || rm -f "$process_file"
    return 1
  fi

  local candidate candidate_pid resolved=
  while IFS=$'\t' read -r candidate candidate_pid; do
    valid_pane_id "$candidate" || continue
    case "$candidate_pid" in
      *[!0-9]*|'') continue ;;
    esac
    if awk -v process="$copilot_pid" -v root="$candidate_pid" '
      { parent[$1] = $2 }
      END {
        current = process
        for (depth = 0; current != "" && current != "0" && depth < 256; depth++) {
          if (current == root) {
            exit 0
          }
          current = parent[current]
        }
        exit 1
      }
    ' "$process_file"; then
      resolved=$candidate
      break
    fi
  done < <("$tmux_bin" list-panes -a -F '#{pane_id}	#{pane_pid}' 2>/dev/null)

  [ "$cleanup_process_file" -eq 0 ] || rm -f "$process_file"
  [ -n "$resolved" ] || return 1
  printf '%s\n' "$resolved"
}

pane_id=$(resolve_pane_id) || exit 0

event=${1:-}
input={}
if [ -z "$event" ]; then
  input=$(cat 2>/dev/null) || exit 0
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$input" || exit 0
  event=$(jq -r '.hookEventName // .hookName // .eventName // .event // empty' <<<"$input" 2>/dev/null)
fi
case "$event" in
  sessionStart) status=idle ;;
  userPromptSubmitted|preToolUse|postToolUse) status=working ;;
  permissionRequest) status=awaiting ;;
  agentStop) status=idle ;;
  sessionEnd) status=removed ;;
  subagentStart|subagentStop) status=working ;;
  *) exit 0 ;;
esac

copilot_home=${COPILOT_HOME:-${HOME:-}/.copilot}
[ -n "$copilot_home" ] || exit 0
state_dir=$copilot_home/agent-status
state_file=$state_dir/${pane_id#%}.json
process_pid=${PPID:-0}
case "$process_pid" in
  *[!0-9]*|'') process_pid=0 ;;
esac

prev_status=
if [ -f "$state_file" ] && [ ! -L "$state_file" ]; then
  prev_status=$(jq -r '.status // empty' "$state_file" 2>/dev/null) || prev_status=
fi

if [ "$status" = removed ]; then
  rm -f -- "$state_file" 2>/dev/null
  emit_refresh
  emit_sketchybar_notify
  exit 0
fi

if [ "$event" = sessionStart ] && [ -f "$state_file" ] && [ ! -L "$state_file" ]; then
  if jq -e --argjson pid "$process_pid" '
    .process_pid == $pid and (.status == "working" or .status == "awaiting")
  ' "$state_file" >/dev/null 2>&1; then
    exit 0
  fi
fi

[ ! -L "$state_dir" ] || exit 0
mkdir -p -- "$state_dir" 2>/dev/null || exit 0
chmod 700 "$state_dir" 2>/dev/null || exit 0

session_id=$(jq -r '.sessionId // .session_id // "unknown"' <<<"$input" 2>/dev/null)
session_id=$(printf '%s' "$session_id" | tr -cd '[:alnum:]_-')
[ -n "$session_id" ] || session_id=unknown

tool_name=$(jq -r '.toolName // .tool_name // empty' <<<"$input" 2>/dev/null)
tool_name=$(printf '%.120s' "$tool_name")
subagent_name=$(jq -r '.agentDisplayName // .agentName // .agent_name // empty' <<<"$input" 2>/dev/null)
subagent_name=$(printf '%.120s' "$subagent_name")
updated_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || exit 0
updated_epoch=$(date '+%s' 2>/dev/null) || exit 0

# Edge-triggered transient signal: only a real completion (agentStop after the
# agent was working) flashes "done". Fresh sessionStart idle and subagentStop
# must not flash.
flash_kind=
flash_until=0
if [ "$event" = agentStop ] && [ "$prev_status" = working ]; then
  flash_kind=done
  flash_until=$((updated_epoch + DONE_FLASH_TTL))
fi

temp_file=$(mktemp "$state_dir/.tmux-agent-status.XXXXXX" 2>/dev/null) || exit 0
trap 'rm -f -- "$temp_file" 2>/dev/null; exit 0' ERR HUP INT TERM

jq -n \
  --arg pane_id "$pane_id" \
  --arg session_id "$session_id" \
  --arg status "$status" \
  --arg event "$event" \
  --arg tool_name "$tool_name" \
  --arg subagent_name "$subagent_name" \
  --arg updated_at "$updated_at" \
  --arg flash_kind "$flash_kind" \
  --argjson process_pid "$process_pid" \
  --argjson updated_epoch "$updated_epoch" \
  --argjson flash_until "$flash_until" '
  {
    pane_id: $pane_id,
    session_id: $session_id,
    process_pid: $process_pid,
    status: $status,
    event: $event,
    updated_at: $updated_at,
    updated_epoch: $updated_epoch
  }
  + (if $tool_name == "" then {} else {tool_name: $tool_name} end)
  + (if $subagent_name == "" then {} else {subagent_name: $subagent_name} end)
  + (if $flash_kind == "" then {} else {flash: {kind: $flash_kind, until_epoch: $flash_until}} end)
' >"$temp_file" 2>/dev/null || exit 0

chmod 600 "$temp_file" 2>/dev/null || exit 0
mv -f -- "$temp_file" "$state_file" 2>/dev/null || exit 0

if [ "$prev_status" != "$status" ] || [ -n "$flash_kind" ]; then
  emit_refresh
  emit_sketchybar_notify
fi
[ "$flash_kind" = done ] && schedule_refresh
exit 0
