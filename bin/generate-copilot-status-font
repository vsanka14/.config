#!/usr/bin/env node

const crypto = require('crypto');
const fs = require('fs');
const Module = require('module');
const path = require('path');

const SOURCE_SHA256 =
  'cc2472e239e17062e7760af87f8f5997720cc0d94aa014a615c418baaf6333a8';
const OPENTYPE_SHA256 =
  '737212d8aae53d1996ef10b315e4369a1542ebb9b94c13c5f99793914745d484';
const SOURCE_CODEPOINT = 0xec3a;
const UNITS_PER_EM = 1000;
const ASCENDER = 1020;
const DESCENDER = -300;
const ADVANCE_WIDTH = 1000;
const CENTER_X = ADVANCE_WIDTH / 2;
const CENTER_Y = 360;
const SCALE = 1.03;
const MAC_EPOCH = 2082844800n;
const CHECKSUM_MAGIC = 0xb1b0afba;

const repoDir = path.resolve(__dirname, '..');
const vscodeApp =
  process.env.VSCODE_APP || '/Applications/Visual Studio Code.app';
const sourcePath =
  process.env.CODICON_FONT_SOURCE ||
  path.join(vscodeApp, 'Contents/Resources/app/out/media/codicon.ttf');
const opentypePath =
  process.env.OPENTYPE_JS_PATH ||
  path.join(
    vscodeApp,
    'Contents/Resources/app/node_modules/opentype.js/dist/opentype.js'
  );
let outputPath = path.join(repoDir, 'kitty/fonts/CopilotStatus.ttf');

function die(message) {
  process.stderr.write(`generate-copilot-status-font: ${message}\n`);
  process.exit(1);
}

for (let index = 2; index < process.argv.length; index += 1) {
  if (process.argv[index] === '--output') {
    outputPath = process.argv[++index];
    if (!outputPath) {
      die('--output requires a path');
    }
  } else if (process.argv[index] === '--help' || process.argv[index] === '-h') {
    process.stdout.write(
      'Usage: generate-copilot-status-font [--output PATH]\n'
    );
    process.exit(0);
  } else {
    die(`unknown argument: ${process.argv[index]}`);
  }
}

function readFile(filePath, description) {
  try {
    return fs.readFileSync(filePath);
  } catch (error) {
    die(`${description} is unavailable at ${filePath}: ${error.message}`);
  }
}

function sha256(contents) {
  return crypto.createHash('sha256').update(contents).digest('hex');
}

function checksum(contents, offset = 0, length = contents.length) {
  let sum = 0;
  const paddedLength = Math.ceil(length / 4) * 4;
  for (let index = 0; index < paddedLength; index += 4) {
    let value = 0;
    for (let byte = 0; byte < 4; byte += 1) {
      const position = offset + index + byte;
      value =
        (value << 8) |
        (position < offset + length ? contents[position] : 0);
    }
    sum = (sum + (value >>> 0)) >>> 0;
  }
  return sum;
}

function normalizeFontTables(contents) {
  const tables = {};
  const tableCount = contents.readUInt16BE(4);
  for (let index = 0; index < tableCount; index += 1) {
    const recordOffset = 12 + index * 16;
    const tag = contents.toString('ascii', recordOffset, recordOffset + 4);
    tables[tag] = {
      recordOffset,
      offset: contents.readUInt32BE(recordOffset + 8),
      length: contents.readUInt32BE(recordOffset + 12)
    };
  }
  if (!tables.head || !tables.post || !tables['OS/2']) {
    die('generated font is missing required OpenType tables');
  }

  contents.writeUInt32BE(0, tables.head.offset + 8);
  contents.writeBigUInt64BE(MAC_EPOCH, tables.head.offset + 20);
  contents.writeBigUInt64BE(MAC_EPOCH, tables.head.offset + 28);
  contents.writeUInt32BE(1, tables.post.offset + 12);
  contents.writeUInt8(9, tables['OS/2'].offset + 35);

  for (const tag of ['head', 'post', 'OS/2']) {
    const table = tables[tag];
    contents.writeUInt32BE(
      checksum(contents, table.offset, table.length),
      table.recordOffset + 4
    );
  }
  contents.writeUInt32BE(
    (CHECKSUM_MAGIC - checksum(contents)) >>> 0,
    tables.head.offset + 8
  );
  return contents;
}

const sourceContents = readFile(sourcePath, 'reviewed Codicons source font');
if (sha256(sourceContents) !== SOURCE_SHA256) {
  die('Codicons source changed; review it before updating the pinned hash');
}

const opentypeContents = readFile(opentypePath, 'reviewed opentype.js module');
if (sha256(opentypeContents) !== OPENTYPE_SHA256) {
  die('opentype.js changed; review it before updating the pinned hash');
}

const fixedPitchNeedle =
  '      weight: options.weightName,\n      fontBBox: options.fontBBox || [0, 0, 0, 0],';
const fixedPitchReplacement =
  '      weight: options.weightName,\n      isFixedPitch: 1,\n      fontBBox: options.fontBBox || [0, 0, 0, 0],';
const boundsNeedle =
  '      fontBBox: [0, globals.yMin, globals.ascender, globals.advanceWidthMax],';
const boundsReplacement =
  '      fontBBox: [globals.xMin, globals.yMin, globals.xMax, globals.yMax],';
const opentypeSource = opentypeContents.toString('utf8');
if (
  opentypeSource.indexOf(fixedPitchNeedle) < 0 ||
  opentypeSource.indexOf(fixedPitchNeedle) !==
    opentypeSource.lastIndexOf(fixedPitchNeedle) ||
  opentypeSource.indexOf(boundsNeedle) < 0 ||
  opentypeSource.indexOf(boundsNeedle) !==
    opentypeSource.lastIndexOf(boundsNeedle)
) {
  die('reviewed opentype.js patch points changed');
}

const patchedModule = new Module(opentypePath, module);
patchedModule.filename = opentypePath;
patchedModule.paths = Module._nodeModulePaths(path.dirname(opentypePath));
patchedModule._compile(
  opentypeSource
    .replace(fixedPitchNeedle, fixedPitchReplacement)
    .replace(boundsNeedle, boundsReplacement),
  opentypePath
);
const opentype = patchedModule.exports;

const sourceBuffer = sourceContents.buffer.slice(
  sourceContents.byteOffset,
  sourceContents.byteOffset + sourceContents.byteLength
);
const sourceFont = opentype.parse(sourceBuffer);
const sourceGlyph = sourceFont.charToGlyph(
  String.fromCodePoint(SOURCE_CODEPOINT)
);
if (sourceGlyph.name !== 'copilot-large') {
  die('expected copilot-large glyph is missing');
}

const bounds = sourceGlyph.getBoundingBox();
const sourceCenterX = (bounds.x1 + bounds.x2) / 2;
const sourceCenterY = (bounds.y1 + bounds.y2) / 2;
const coordinateScale = (UNITS_PER_EM / sourceFont.unitsPerEm) * SCALE;
const transformedPath = new opentype.Path();
transformedPath.commands = sourceGlyph.path.commands.map((command) => {
  const transformed = {type: command.type};
  for (const key of ['x', 'x1', 'x2']) {
    if (command[key] !== undefined) {
      transformed[key] = Math.round(
        (command[key] - sourceCenterX) * coordinateScale + CENTER_X
      );
    }
  }
  for (const key of ['y', 'y1', 'y2']) {
    if (command[key] !== undefined) {
      transformed[key] = Math.round(
        (command[key] - sourceCenterY) * coordinateScale + CENTER_Y
      );
    }
  }
  return transformed;
});

const emptyPath = () => new opentype.Path();
const outputFont = new opentype.Font({
  familyName: 'Copilot Status',
  styleName: 'Regular',
  fullName: 'Copilot Status Regular',
  postScriptName: 'CopilotStatus-Regular',
  unitsPerEm: UNITS_PER_EM,
  ascender: ASCENDER,
  descender: DESCENDER,
  createdTimestamp: 0,
  weightClass: 500,
  widthClass: 5,
  glyphs: [
    new opentype.Glyph({
      name: '.notdef',
      advanceWidth: ADVANCE_WIDTH,
      path: emptyPath()
    }),
    new opentype.Glyph({
      name: 'space',
      unicode: 0x20,
      advanceWidth: ADVANCE_WIDTH,
      path: emptyPath()
    }),
    new opentype.Glyph({
      name: 'copilot-large',
      unicode: SOURCE_CODEPOINT,
      advanceWidth: ADVANCE_WIDTH,
      path: transformedPath
    })
  ],
  designer: 'Microsoft Corporation; modified for dotfiles status use',
  designerURL: 'https://github.com/microsoft/vscode-codicons',
  manufacturer: 'Microsoft Corporation; modified by vsankar',
  manufacturerURL: 'https://github.com/microsoft/vscode-codicons',
  license: 'CC BY 4.0; modified by scaling and repositioning copilot-large',
  licenseURL: 'https://creativecommons.org/licenses/by/4.0/',
  version: 'Version 1.0',
  description:
    'Single-icon derivative of VS Code Codicons for Kitty/tmux status rendering.',
  copyright:
    'Copyright Microsoft Corporation. Modified and redistributed under CC BY 4.0.'
});
outputFont.tables.post = {isFixedPitch: 1};

const outputContents = normalizeFontTables(
  Buffer.from(outputFont.toArrayBuffer())
);
const absoluteOutputPath = path.resolve(outputPath);
const temporaryPath = `${absoluteOutputPath}.tmp-${process.pid}`;
fs.mkdirSync(path.dirname(absoluteOutputPath), {recursive: true});
try {
  fs.writeFileSync(temporaryPath, outputContents, {mode: 0o644});
  fs.renameSync(temporaryPath, absoluteOutputPath);
} finally {
  fs.rmSync(temporaryPath, {force: true});
}
process.stdout.write(`${absoluteOutputPath}\t${sha256(outputContents)}\n`);
